#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build-tests"

if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
else
  QMAKE=qmake
fi

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"
"$QMAKE" "$ROOT/tests/tests.pro"
make -j"$(nproc 2>/dev/null || echo 1)"
QT_QPA_PLATFORM=offscreen ./tst_omacal

# The date and recurrence maths lives in QML's JavaScript, so it is checked
# separately — and in a couple of timezones, since the awkward cases are the
# days that are 23 or 25 hours long.
if command -v node >/dev/null 2>&1; then
  for zone in America/New_York Europe/Berlin Australia/Lord_Howe; do
    TZ="$zone" node "$ROOT/tests/tst_dates.js"
  done
else
  echo "SKIP   date and recurrence checks (node is not installed)"
fi
