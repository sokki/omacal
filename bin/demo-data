#!/usr/bin/python3
# Development helper: seeds evolution-data-server with a "Demo" provider
# holding three calendars (Work, Family, Sports Club) and fills them with a
# realistic, mostly busy schedule spanning one year around today.
#
#   bin/demo-data            create (or recreate) the demo calendars
#   bin/demo-data --remove   remove them again
#
# Requires python-gobject and evolution-data-server.

import os
import random
import shutil
import sys
import time
import uuid
from datetime import date, datetime, timedelta, timezone

import gi

gi.require_version("EDataServer", "1.2")
gi.require_version("ECal", "2.0")
gi.require_version("ICalGLib", "4.0")
from gi.repository import ECal, EDataServer, ICalGLib  # noqa: E402

PROVIDER_UID = "omacal-demo"
CALENDARS = [
    ("omacal-demo-work", "Work", "#4a90d9"),
    ("omacal-demo-family", "Family", "#6bbd68"),
    ("omacal-demo-sports", "Sports Club", "#e0843c"),
    ("omacal-demo-birthdays", "Birthdays", "#c586c0"),
]

TODAY = date.today()
RANGE_START = TODAY - timedelta(days=365)
RANGE_END = TODAY + timedelta(days=365)

random.seed(42)


# ------------------------------------------------------------- iCal helpers

def utc(day, hour, minute):
    """Local wall-clock time on `day` as an iCal UTC timestamp."""
    local = datetime(day.year, day.month, day.day, hour, minute).astimezone()
    return local.astimezone(timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def esc(text):
    """iCalendar TEXT escaping for values that may hold , ; or newlines."""
    return (text.replace("\\", "\\\\").replace(";", "\\;")
                .replace(",", "\\,").replace("\n", "\\n"))


def vevent(summary, lines, alarm_minutes=None, description=None):
    body = [
        "BEGIN:VEVENT",
        f"UID:{uuid.uuid4()}@omacal-demo",
        f"DTSTAMP:{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}",
        f"SUMMARY:{esc(summary)}",
        *lines,
    ]
    if description:
        body.append(f"DESCRIPTION:{esc(description)}")
    if alarm_minutes is not None:
        body += [
            "BEGIN:VALARM",
            "ACTION:DISPLAY",
            f"DESCRIPTION:{esc(summary)}",
            f"TRIGGER:-PT{alarm_minutes}M",
            "END:VALARM",
        ]
    body.append("END:VEVENT")
    return "\r\n".join(body)


def timed(summary, day, hour, minute, duration_minutes, location=None,
          rrule=None, alarm_minutes=None, description=None):
    start = datetime(day.year, day.month, day.day, hour, minute)
    end = start + timedelta(minutes=duration_minutes)
    lines = [f"DTSTART:{utc(day, hour, minute)}",
             f"DTEND:{utc(end.date(), end.hour, end.minute)}"]
    if location:
        lines.append(f"LOCATION:{esc(location)}")
    if rrule:
        lines.append(f"RRULE:{rrule}")
    return vevent(summary, lines, alarm_minutes, description)


def all_day(summary, first_day, day_count=1, rrule=None, location=None,
            description=None):
    end = first_day + timedelta(days=day_count)
    lines = [f"DTSTART;VALUE=DATE:{first_day.strftime('%Y%m%d')}",
             f"DTEND;VALUE=DATE:{end.strftime('%Y%m%d')}"]
    if location:
        lines.append(f"LOCATION:{esc(location)}")
    if rrule:
        lines.append(f"RRULE:{rrule}")
    return vevent(summary, lines, description=description)


# A spread of note lengths, from a couple of words to a full agenda.
NOTES = [
    "Bring the good shoes.",
    "Don't forget the insurance card.",
    "Agenda: budget, staffing, and the Q3 roadmap. Dana presents the new "
    "forecast; bring last month's numbers.",
